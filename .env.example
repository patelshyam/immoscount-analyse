# Copy to .env — never commit .env
POSTGRES_USER=immo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=immo

# Used by `pnpm dev` / Prisma CLI on the host (change DB_HOST_PORT + the port below if 5432 is taken)
DB_HOST_PORT=5432
DATABASE_URL=postgresql://immo:change-me@127.0.0.1:5432/immo

# Host port for the web app (extension default: http://127.0.0.1:3000)
APP_HOST_PORT=3000
