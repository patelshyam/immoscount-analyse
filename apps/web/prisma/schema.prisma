generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Source {
  is24
  immowelt
  manual
}

enum PropertyType {
  apartment
  house
  multi_family
}

enum StatusKind {
  open
  excluded
  closed
}

model Property {
  id                    String       @id @default(cuid())
  source                Source
  externalId            String?
  url                   String?
  title                 String?
  propertyType          PropertyType
  street                String?
  postalCode            String?
  city                  String?
  state                 String?
  price                 Decimal      @db.Decimal(12, 2)
  livingArea            Decimal      @db.Decimal(8, 2)
  rooms                 Decimal?     @db.Decimal(4, 1)
  hausgeldMonthly       Decimal?     @db.Decimal(10, 2)
  actualColdRentMonthly Decimal?     @db.Decimal(10, 2)
  rentOverrideMonthly   Decimal?     @db.Decimal(10, 2)
  brokerFeeOverride     Decimal?     @db.Decimal(6, 5)
  renovationCost        Decimal      @default(0) @db.Decimal(12, 2)
  yearBuilt             Int?
  statusId              String
  status                PipelineStatus @relation(fields: [statusId], references: [id])
  notes                 String       @default("")
  excludedReason        String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  lastSeenAt            DateTime     @default(now())

  snapshots    PropertySnapshot[]
  statusEvents StatusEvent[]
  shareLinks   ShareLink[]

  @@unique([source, externalId])
  @@index([statusId])
}

model PropertySnapshot {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  capturedAt DateTime @default(now())
  price      Decimal  @db.Decimal(12, 2)
  fields     Json

  @@index([propertyId, capturedAt])
}

model StatusEvent {
  id           String          @id @default(cuid())
  propertyId   String
  property     Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  fromStatusId String?
  fromStatus   PipelineStatus? @relation("fromStatus", fields: [fromStatusId], references: [id], onDelete: SetNull)
  toStatusId   String
  toStatus     PipelineStatus  @relation("toStatus", fields: [toStatusId], references: [id])
  at           DateTime        @default(now())
  note         String?

  @@index([propertyId, at])
}

model PipelineStatus {
  id         String     @id @default(cuid())
  name       String     @unique
  color      String
  sortOrder  Int
  kind       StatusKind @default(open)
  properties Property[]
  fromEvents StatusEvent[] @relation("fromStatus")
  toEvents   StatusEvent[] @relation("toStatus")
}

/// Singleton row, id = 1
model Settings {
  id          Int    @id @default(1)
  assumptions Json
  apiToken    String
}

model TransferTaxRate {
  state      String    @id
  rate       Decimal   @db.Decimal(6, 5)
  validFrom  DateTime? @db.Date
  verifiedOn DateTime? @db.Date
  source     String?
}

model CityState {
  cityKey     String @id
  displayName String
  state       String
}

model RentReference {
  id            String  @id @default(cuid())
  city          String
  sizeMin       Decimal @db.Decimal(8, 2)
  sizeMax       Decimal? @db.Decimal(8, 2)
  eurPerM2      Decimal @db.Decimal(8, 2)
  source        String
  year          Int
  isPlaceholder Boolean @default(false)
  notes         String?

  @@index([city])
}

model ShareLink {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  token      String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
}
